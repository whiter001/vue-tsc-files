{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-eval": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unused-vars": "error"
  },
  "ignorePatterns": ["bin", "node_modules"]
}
