{
  "name": "@whiter001/vue-tsc-files",
  "version": "1.3.1",
  "description": "A tiny tool to run vue-tsc on specific files without ignoring tsconfig.json",
  "keywords": [
    "lint-staged",
    "pnpm",
    "tsc",
    "tsc-files",
    "vue-tsc",
    "vue-tsc-files"
  ],
  "license": "MIT",
  "author": "whiter001",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiter001/vue-tsc-files.git"
  },
  "bin": {
    "vue-tsc-files": "./vue-tsc-files"
  },
  "files": [
    "vue-tsc-files",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./vue-tsc-files",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rolldown -c",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "check": "pnpm run lint && pnpm run fmt:check && npx tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@json-types/tsconfig": "^0.11.0",
    "@types/node": "^26.6.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "rolldown": "^1.2.11",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "vue-tsc": ">=2.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.4.1"
}
